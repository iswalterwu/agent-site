{
  "name": "dsh-agent-site",
  "version": "0.1.0",
  "description": "Watch pi, Claude Code and DSH sessions as a pixel-art site on your desktop.",
  "icon": "assets/logo-192.png",
  "type": "module",
  "main": "lib/host.mjs",
  "license": "MIT",
  "engines": { "node": ">=22.19.0", "dsh": "0.2.1-rc.3 || 0.2.2-rc.1" },
  "repository": { "type": "git", "url": "https://github.com/iswalterwu/agent-site.git", "directory": "packages/dsh-plugin" },
  "homepage": "https://github.com/iswalterwu/agent-site",
  "keywords": ["dsh-plugin", "deepseek-harness", "agent-monitoring", "desktop"],
  "exports": {
    ".": "./lib/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./assets/logo-192.png",
    "./locale/*.json": "./locale/*.json",
    "./locale/*.md": "./locale/*.md"
  },
  "files": ["lib", "locale", "assets", "screenshots.json", "cordis.patch.yml", "README.md", "README.zh-CN.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3 || 0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@types/react": "18.3.26",
    "react": "18.3.1"
  }
}
